@startuml
title Diagram klas - kontrakt vpp-domain i moduły vpp-engine, vpp-data, vpp-app
hide empty members
' Rozmiar: podgląd PlantUML (także w IntelliJ) ucina obraz szerszy niż 4096 px.
' - left to right direction: moduły układają się jeden pod drugim zamiast obok siebie,
' - mniejsze odstępy i czcionka: zwarty układ,
' - scale max: zabezpieczenie, gdy diagram urośnie (zmniejsza obraz zamiast go ucinać).
left to right direction
scale max 4000 width
set separator none
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam defaultFontSize 12
skinparam nodesep 25
skinparam ranksep 45

package "vpp-domain (pl.agh.po.vpp.domain)" {

    package "Konfiguracja osiedla" {
        class EstateConfig <<record>> {
            name : String
            location : Location
            assets : List<AssetConfig>
            --
            assetsOfType(type : AssetType) : List<AssetConfig>
            findAsset(id : String) : Optional<AssetConfig>
        }
        class AssetConfig <<record>> {
            id : String
            type : AssetType
            name : String
            pvPeakKw : double
            ratedPowerKw : double
            capacityKwh : double
            dwellings : int
            position : Position
        }
        class Location <<record>> {
            latitude : double
            longitude : double
            zone : ZoneId
        }
        class Position <<record>> {
            x : double
            z : double
        }
        enum AssetType {
            APARTMENT_BLOCK
            HOUSE
            SCHOOL
            WIND_TURBINE
            BATTERY
            GRID
            --
            isBuilding() : boolean
        }
    }

    package "Ustawienia operatora" {
        class OperatorSettings <<record>> {
            strategy : StrategyType
            batteryMode : BatteryMode
            outages : List<AssetOutage>
            exportLimitKw : Double
            seed : long
            --
            {static} defaults() : OperatorSettings
            hasExportLimit() : boolean
            withStrategy(s : StrategyType) : OperatorSettings
        }
        class AssetOutage <<record>> {
            assetId : String
            from : LocalTime
            to : LocalTime
            --
            {static} allDay(assetId : String) : AssetOutage
            isActiveAt(time : LocalTime) : boolean
        }
        enum StrategyType {
            RULE_BASED
            PRICE_BASED
        }
        enum BatteryMode {
            AUTO
            CHARGE_NOW
            HOLD_FOR_EVENING
        }
    }

    package "Czas i warunki" {
        class Timeline <<record>> {
            date : LocalDate
            step : Duration
            zone : ZoneId
            --
            {static} of(date : LocalDate, zone : ZoneId) : Timeline
            start() : Instant
            end() : Instant
            steps() : List<Instant>
            size() : int
            stepHours() : double
        }
        class Weather <<record>> {
            time : Instant
            tiltedIrradianceWm2 : double
            windSpeed80mMs : double
            temperatureC : double
            cloudCoverPct : double
        }
        class Conditions <<record>> {
            time : Instant
            weather : Weather
            pricePlnPerKwh : double
        }
    }

    package "Wyniki" {
        class SimulationResult <<record>> {
            timeline : Timeline
            settings : OperatorSettings
            steps : List<StepResult>
        }
        class StepResult <<record>> {
            time : Instant
            step : Duration
            conditions : Conditions
            flows : List<AssetFlow>
            productionKw : double
            consumptionKw : double
            batteryKw : double
            gridKw : double
            batterySocKwh : double
            --
            importKw() : double
            exportKw() : double
            energyKwh(powerKw : double) : double
            balanceErrorKw() : double
            flowOf(assetId : String) : Optional<AssetFlow>
        }
        class AssetFlow <<record>> {
            assetId : String
            type : AssetType
            productionKw : double
            consumptionKw : double
            --
            netKw() : double
        }
        class BatteryState <<record>> {
            socKwh : double
            capacityKwh : double
            --
            socFraction() : double
            isFull() : boolean
            isEmpty() : boolean
        }
        class Dispatch <<record>> {
            batteryKw : double
            gridKw : double
        }
    }

    package "Interfejsy" {
        interface WeatherProvider {
            weatherFor(t : Timeline, l : Location) : List<Weather>
        }
        interface PriceProvider {
            pricesFor(t : Timeline) : List<Double>
        }
        interface SimulationListener {
            onStep(s : StepResult)
            onBatteryFull(t : Instant)
            onBatteryEmpty(t : Instant)
            onExportLimitReached(t : Instant)
            onFinished(r : SimulationResult)
        }
        interface DispatchStrategy {
            decide(netKw : double, b : BatteryState, c : Conditions) : Dispatch
        }
        interface EnergyAsset {
            id() : String
            type() : AssetType
        }
        interface PowerSource {
            powerKw(c : Conditions) : double
        }
        interface Load {
            demandKw(c : Conditions) : double
        }
        interface Storage {
            state() : BatteryState
            ratedPowerKw() : double
            apply(requestedKw : double, stepHours : double) : double
        }
    }

    package "Wyjątki" {
        class InvalidEstateException
        class WeatherUnavailableException
    }
}
package "vpp-engine (pl.agh.po.vpp.engine)" {
    class EstateBuilder {
        + build(estate : EstateConfig) : VirtualPowerPlant
    }
    class Simulation {
        - location : Location
        - settings : OperatorSettings
        + run(timeline : Timeline) : SimulationResult
    }
    class VirtualPowerPlant {
        - buildings : List<AbstractLoad>
        - gridId : String
        - inactiveFlows : List<AssetFlow>
        + step(c : Conditions, stepHours : double) : StepResult
    }
    class EnergyBalanceValidator {
        + {static} validate(step : StepResult)
    }
    package "asset" {
        abstract class AbstractLoad {
            - zone : ZoneId
            - state : AssetState
            + demandKw(c : Conditions) : double
            + roofProductionKw(c : Conditions) : double
            + setState(state : AssetState)
            # {abstract} profileDemandKw(time : LocalDateTime, c : Conditions) : double
        }
        class ApartmentBlock
        class House
        class School {
            - baseKw : double
            - lessonsKw : double
        }
        class ResidentialProfile <<record>> {
            baseKw : double
            morningKw : double
            eveningKw : double
            heatLossKwPerC : double
            balanceTemperatureC : double
            heatingCop : double
            + demandKw(time : LocalDateTime, temperatureC : double) : double
        }
        enum AssetState {
            RUNNING
            FAILED
            DISABLED
        }
        abstract class AbstractGenerator {
            - id : String
            - name : String
            - type : AssetType
            - ratedPowerKw : double
            - state : AssetState
            --
            + powerKw(c : Conditions) : double
            + produceKw(c : Conditions) : double
            # {abstract} rawPowerKw(c : Conditions) : double
        }
        class SolarPanel {
            + {static} DEFAULT_EFFICIENCY : double
            + {static} DEFAULT_TEMP_COEFFICIENT_PER_C : double
            - areaM2 : double
            - efficiency : double
            - tempCoefficientPerC : double
            --
            # rawPowerKw(c : Conditions) : double
        }
    }
}

PowerSource <|.. AbstractGenerator
AbstractGenerator <|-- SolarPanel
AbstractGenerator --> AssetState
EstateBuilder ..> EstateConfig
EstateBuilder ..> VirtualPowerPlant : <<create>>
Simulation --> VirtualPowerPlant
Simulation --> WeatherProvider
Simulation --> PriceProvider
Simulation --> "0..*" SimulationListener
Simulation ..> SimulationResult : <<create>>
VirtualPowerPlant *-- "0..*" AbstractLoad
VirtualPowerPlant ..> EnergyBalanceValidator
VirtualPowerPlant ..> StepResult : <<create>>
Load <|.. AbstractLoad
AbstractLoad <|-- ApartmentBlock
AbstractLoad <|-- House
AbstractLoad <|-- School
AbstractLoad *-- "0..1" SolarPanel : dachowe PV
AbstractLoad --> AssetState
ApartmentBlock --> ResidentialProfile
House --> ResidentialProfile



package "vpp-data (pl.agh.po.vpp.data)" {
    class EstateLoader {
        load(file : Path) : EstateConfig
        parse(json : Reader, source : String) : EstateConfig
    }

    package "weather" {
        class SyntheticWeatherProvider {
            {static} PANEL_TILT_DEG : double
            - seed : long
            + SyntheticWeatherProvider(seed : long)
            + weatherFor(t : Timeline, l : Location) : List<Weather>
            ~ {static} clearSkyTiltedIrradianceWm2(time : Instant, l : Location) : double
            ~ {static} cloudFactor(cloudPct : double) : double
        }
        class OpenMeteoWeatherProvider {
            - fetcher : HttpFetcher
            - clock : Clock
            + OpenMeteoWeatherProvider(fetcher : HttpFetcher, clock : Clock)
            + weatherFor(t : Timeline, l : Location) : List<Weather>
            ~ sourceFor(day : LocalDate, first : LocalDate, last : LocalDate) : Source
        }
        enum "OpenMeteoWeatherProvider.Source" as OpenMeteoSource {
            FORECAST
            ARCHIVE
        }
        interface HttpFetcher <<functional>> {
            get(uri : URI) : HttpResult
        }
        class "HttpFetcher.HttpResult" as HttpResult <<record>> {
            statusCode : int
            body : String
        }
        class JdkHttpFetcher {
            - client : HttpClient
            - timeout : Duration
            + get(uri : URI) : HttpResult
        }
    }

    package "price" {
        class SyntheticPriceProvider {
            - seed : long
            + SyntheticPriceProvider(seed : long)
            + pricesFor(t : Timeline) : List<Double>
        }
    }

    package "export" {
        class CsvExporter {
            + {static} COLUMNS : List<String>
            + write(r : SimulationResult, file : Path)
            + write(r : SimulationResult, out : Writer)
        }
    }

    package "metrics" {
        class MetricsCalculator {
            - exportPriceFactor : double
            + MetricsCalculator(exportPriceFactor : double)
            + calculate(r : SimulationResult) : DayMetrics
        }
        class DayMetrics <<record>> {
            productionKwh : double
            consumptionKwh : double
            importKwh : double
            exportKwh : double
            batteryChargeKwh : double
            batteryDischargeKwh : double
            selfSufficiency : Double
            selfConsumption : Double
            importCostPln : double
            exportRevenuePln : double
            netCostPln : double
            peakImportKw : double
            peakExportKw : double
        }
    }
}

EstateLoader ..> EstateConfig : <<create>>
EstateLoader ..> InvalidEstateException : <<throws>>
WeatherProvider <|.. SyntheticWeatherProvider
WeatherProvider <|.. OpenMeteoWeatherProvider
OpenMeteoWeatherProvider --> HttpFetcher
OpenMeteoWeatherProvider ..> OpenMeteoSource
OpenMeteoWeatherProvider ..> WeatherUnavailableException : <<throws>>
HttpFetcher <|.. JdkHttpFetcher
HttpFetcher ..> HttpResult
PriceProvider <|.. SyntheticPriceProvider
CsvExporter ..> SimulationResult
MetricsCalculator ..> SimulationResult
MetricsCalculator ..> DayMetrics : <<create>>

package "vpp-app (pl.agh.po.vpp.app)" {
    class Main <<final>> {
        ~ {static} run(args : String[], out : PrintStream, err : PrintStream) : int
        ~ {static} run(args, out, err, sim : DaySimulator) : int
        + {static} main(args : String[])
    }
    class CliOptions <<record>> {
        date : LocalDate
        seed : long
        estateFile : Path
        outputFile : Path
        --
        + {static} parse(args : String[], today : LocalDate) : CliOptions
    }
    interface DaySimulator {
        simulate(estate : EstateConfig, t : Timeline, s : OperatorSettings,\n  w : WeatherProvider, p : PriceProvider, listeners : List<SimulationListener>) : SimulationResult
    }
    class EngineDaySimulator
    class ConsoleProgressListener {
        - totalSteps : int
        - doneSteps : int
        + onStep(s : StepResult)
        + onFinished(r : SimulationResult)
    }
    class ConsoleMetricsFormatter <<final>> {
        + {static} format(m : DayMetrics) : String
    }
}

DaySimulator <|.. EngineDaySimulator
EngineDaySimulator ..> EstateBuilder
EngineDaySimulator ..> Simulation
SimulationListener <|.. ConsoleProgressListener
Main ..> CliOptions
Main ..> DaySimulator
Main ..> EstateLoader
Main ..> SyntheticWeatherProvider : <<create>>
Main ..> SyntheticPriceProvider : <<create>>
Main ..> CsvExporter
Main ..> ConsoleProgressListener : <<create>>
Main ..> MetricsCalculator
Main ..> ConsoleMetricsFormatter
ConsoleMetricsFormatter ..> DayMetrics
DaySimulator ..> SimulationResult : <<create>>

note bottom of EngineDaySimulator
  Adapter silnika M1: budynki, PV i GRID.
  Wiatrak i bateria nieaktywne do M2.
end note

note bottom of SyntheticPriceProvider
  Profil dobowy: tanio w nocy i w południe,
  szczyt rano i najdrożej wieczorem, w weekend taniej.
  W M3 obok: CsvPriceProvider (ceny TGE).
end note

note bottom of SyntheticWeatherProvider
  Pogoda bez internetu, powtarzalna:
  ten sam seed + ten sam dzień = ta sama pogoda.
end note

note bottom of OpenMeteoWeatherProvider
  Prawdziwa pogoda: Forecast API (co 15 min, ~92 dni wstecz
  i 15 dni naprzód) albo Historical API (co godzinę, starsze dni).
  Testy podstawiają HttpFetcher z nagranymi odpowiedziami.
end note

' --- kompozycja rekordów ---
EstateConfig *-- "1" Location
EstateConfig *-- "1..*" AssetConfig
AssetConfig --> AssetType
AssetConfig *-- "1" Position

OperatorSettings --> StrategyType
OperatorSettings --> BatteryMode
OperatorSettings *-- "0..*" AssetOutage

Conditions *-- "1" Weather

SimulationResult --> Timeline
SimulationResult --> OperatorSettings
SimulationResult *-- "0..*" StepResult
StepResult *-- "1" Conditions
StepResult *-- "0..*" AssetFlow
AssetFlow --> AssetType

' --- hierarchia interfejsów (implementacje w vpp-engine) ---
EnergyAsset <|-- PowerSource
EnergyAsset <|-- Load
EnergyAsset <|-- Storage
EnergyAsset ..> AssetType

' --- najważniejsze zależności interfejsów (pozostałe typy widać w sygnaturach metod) ---
WeatherProvider ..> Weather : <<create>>
WeatherProvider ..> WeatherUnavailableException : <<throws>>
SimulationListener ..> SimulationResult
DispatchStrategy ..> Dispatch : <<create>>
Storage ..> BatteryState

RuntimeException <|-- InvalidEstateException
RuntimeException <|-- WeatherUnavailableException

note bottom of StepResult
  Znaki: batteryKw + ładowanie / − rozładowanie,
  gridKw + import / − eksport.
  Bilans: productionKw + gridKw = consumptionKw + batteryKw
end note

note bottom of AssetFlow
  Obie moce ≥ 0, z punktu widzenia sieci osiedla.
  Bateria: production = rozładowanie, consumption = ładowanie.
  Sieć: production = import, consumption = eksport.
end note
@enduml
