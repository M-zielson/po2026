<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>pl.agh.po.vpp</groupId>
        <artifactId>vpp-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>vpp-app</artifactId>
    <name>VPP App</name>
    <description>Tryb konsolowy (Main) i serwer HTTP (Javalin): REST, SSE, serwowanie frontendu.</description>

    <dependencies>
        <!-- Aplikacja jako jedyna zna wszystkie moduły i składa je w całość -->
        <dependency>
            <groupId>pl.agh.po.vpp</groupId>
            <artifactId>vpp-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>pl.agh.po.vpp</groupId>
            <artifactId>vpp-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>pl.agh.po.vpp</groupId>
            <artifactId>vpp-data</artifactId>
        </dependency>

        <!-- Implementacja logowania dla SLF4J; tylko aplikacja ją wybiera, biblioteki znają samo API -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Jeden plik jar ze wszystkimi zależnościami: java -jar vpp-app.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- Osobny plik vpp-app/target/vpp-app.jar; zwykły jar modułu zostaje bez zmian -->
                            <outputFile>${project.build.directory}/vpp-app.jar</outputFile>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>pl.agh.po.vpp.app.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- Licencje bibliotek (Jackson ma je w każdym pliku) łączone w jeden plik zamiast konfliktu -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
